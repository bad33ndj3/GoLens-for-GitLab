{
  "manifest_version": 3,
  "name": "GoLens Playwright Harness Prototype",
  "version": "0.0.0",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"]
    }
  ]
}
